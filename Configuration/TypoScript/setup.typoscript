# Rollovercollection 2 - CIRCLE
# Requires bootstrap_package (content elements image, textpic, media, textmedia).

# Label of the "more" button
lib.rollovercollection2.label.readMore = TEXT
lib.rollovercollection2.label.readMore {
  value = MORE
  lang.it = DETTAGLI
}

# Partials of this extension are added on top of the bootstrap_package ones,
# but only for content elements using one of the CIRCLE layouts (tt_content.layout).
# Every other layout keeps the plain bootstrap_package rendering.
tt_content.image.partialRootPaths {
  2650 = EXT:rollovercollection2/Resources/Private/Partials/ContentElements/
  2650.stdWrap.if {
    value = 2651,2652,2653,2654,2655,2656,2657
    isInList.field = layout
  }
}
tt_content.textpic.partialRootPaths {
  2650 = EXT:rollovercollection2/Resources/Private/Partials/ContentElements/
  2650.stdWrap.if {
    value = 2651,2652,2653,2654,2655,2656,2657
    isInList.field = layout
  }
}
tt_content.media.partialRootPaths {
  2650 = EXT:rollovercollection2/Resources/Private/Partials/ContentElements/
  2650.stdWrap.if {
    value = 2651,2652,2653,2654,2655,2656,2657
    isInList.field = layout
  }
}
tt_content.textmedia.partialRootPaths {
  2650 = EXT:rollovercollection2/Resources/Private/Partials/ContentElements/
  2650.stdWrap.if {
    value = 2651,2652,2653,2654,2655,2656,2657
    isInList.field = layout
  }
}

# Settings handed over to the partials as {settings.R2...}
tt_content.image.settings {
  R2titleRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.titleRawdataOutput}
  R2captionRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.captionRawdataOutput}
  R2showMoreLink = {$plugin.tx_rollovercollection2_rollovereffect2.settings.showMoreLink}
  R2imageMaxWidth = {$plugin.tx_rollovercollection2_rollovereffect2.settings.imageMaxWidth}
}
tt_content.textpic.settings {
  R2titleRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.titleRawdataOutput}
  R2captionRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.captionRawdataOutput}
  R2showMoreLink = {$plugin.tx_rollovercollection2_rollovereffect2.settings.showMoreLink}
  R2imageMaxWidth = {$plugin.tx_rollovercollection2_rollovereffect2.settings.imageMaxWidth}
}
tt_content.media.settings {
  R2titleRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.titleRawdataOutput}
  R2captionRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.captionRawdataOutput}
  R2showMoreLink = {$plugin.tx_rollovercollection2_rollovereffect2.settings.showMoreLink}
  R2imageMaxWidth = {$plugin.tx_rollovercollection2_rollovereffect2.settings.imageMaxWidth}
}
tt_content.textmedia.settings {
  R2titleRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.titleRawdataOutput}
  R2captionRawdataOutput = {$plugin.tx_rollovercollection2_rollovereffect2.settings.captionRawdataOutput}
  R2showMoreLink = {$plugin.tx_rollovercollection2_rollovereffect2.settings.showMoreLink}
  R2imageMaxWidth = {$plugin.tx_rollovercollection2_rollovereffect2.settings.imageMaxWidth}
}

# Theme styles, compiled by the SCSS parser of bootstrap_package.
# The variables come from plugin.bootstrap_package.settings.scss.rollover2-*
page.includeCSS {
  rollovercollection2 = {$plugin.tx_rollovercollection2_rollovereffect2.view.scssPath}theme.scss
}
