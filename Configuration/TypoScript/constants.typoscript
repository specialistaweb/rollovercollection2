  # cat=bootstrap package: rollovercollection2-circle/style3/121; type=string; label=$rollover2-style3-titlecolor: title (heading) color
  rollover2-style3-titlecolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style3/122; type=string; label=$rollover2-style3-textcolor: text (paragraph) color
  rollover2-style3-textcolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style3/123; type=string; label=$rollover2-style3-hoverlinkcolor: hover link color
  rollover2-style3-hoverlinkcolor = yellow

  # cat=bootstrap package: rollovercollection2-circle/style4/124; type=string; label=$rollover2-style4-iconsize: circle width/height (140-280px)
