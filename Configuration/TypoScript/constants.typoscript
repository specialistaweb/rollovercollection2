# Rollovercollection 2 - CIRCLE: constants.
# Used when the extension is included as static TypoScript template (sys_template record).
# Sites using the site set "Specialistaweb/Rollovercollection2" get the same values from
# Configuration/Sets/Rollovercollection2/settings.definitions.yaml (Site Management > Settings).
# Keep the defaults of the two files in sync.

# customsubcategory=general=General
plugin.tx_rollovercollection2_rollovereffect2 {
  view {
    # cat=bootstrap package: rollovercollection2-circle/general/010; type=string; label=Path to the SCSS folder. Must contain theme.scss, with trailing slash
    scssPath = EXT:rollovercollection2/Resources/Public/Scss/Theme/
  }
  settings {
    # cat=bootstrap package: rollovercollection2-circle/general/020; type=boolean; label=Title: keep HTML typed by editors. Cleaned by the TYPO3 HTML sanitizer. Off = plain text
    titleRawdataOutput = 0
    # cat=bootstrap package: rollovercollection2-circle/general/030; type=boolean; label=Caption: keep HTML typed by editors. Cleaned by the TYPO3 HTML sanitizer. Off = plain text
    captionRawdataOutput = 0
    # cat=bootstrap package: rollovercollection2-circle/general/040; type=boolean; label=Show the "more" link. Off = the whole circle is linked
    showMoreLink = 1
    # cat=bootstrap package: rollovercollection2-circle/general/050; type=int+; label=Maximum image width in pixels for styles #1 and #2. 0 = original file
    imageMaxWidth = 800
  }
}

#####################
### SCSS SETTINGS ###
#####################

# customsubcategory=common=Common settings
# customsubcategory=style1=Style#1 settings
# customsubcategory=style2=Style#2 settings
# customsubcategory=style3=Style#3 settings
# customsubcategory=style4=Style#4 settings
# customsubcategory=style5=Style#5 settings
# customsubcategory=style6=Style#6 settings
# customsubcategory=style7=Style#7 settings

plugin.bootstrap_package.settings.scss {

  # cat=bootstrap package: rollovercollection2-circle/common/101; type=string; label=$rollover2-brand-primary: base color for all effects
  rollover2-brand-primary = $primary

  # cat=bootstrap package: rollovercollection2-circle/style1/102; type=string; label=$rollover2-style1-iconsize: circle width/height (140-280px)
  rollover2-style1-iconsize = 180px
  # cat=bootstrap package: rollovercollection2-circle/style1/103; type=options[none,block]; label=$rollover2-style1-showcaption: display or not the outside caption
  rollover2-style1-showcaption = none
  # cat=bootstrap package: rollovercollection2-circle/style1/104; type=string; label=$rollover2-style1-insetboxshadow: inset box shadow color
  rollover2-style1-insetboxshadow = rgba(128,255,255,0.6)
  # cat=bootstrap package: rollovercollection2-circle/style1/105; type=string; label=$rollover2-style1-hoverbg: mask hover bg
  rollover2-style1-hoverbg = rgba(63,147,147, 0.8)
  # cat=bootstrap package: rollovercollection2-circle/style1/106; type=string; label=$rollover2-style1-titlecolor: title (heading) color
  rollover2-style1-titlecolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style1/107; type=string; label=$rollover2-style1-textcolor: text (paragraph) color
  rollover2-style1-textcolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style1/108; type=string; label=$rollover2-style1-hoverlinkcolor: hover link color
  rollover2-style1-hoverlinkcolor = yellow

  # cat=bootstrap package: rollovercollection2-circle/style2/109; type=string; label=$rollover2-style2-iconsize: circle width/height (140-280px)
  rollover2-style2-iconsize = 180px
  # cat=bootstrap package: rollovercollection2-circle/style2/110; type=options[none,block]; label=$rollover2-style2-showcaption: display or not the outside caption
  rollover2-style2-showcaption = block
  # cat=bootstrap package: rollovercollection2-circle/style2/111; type=string; label=$rollover2-style2-insetboxshadow: inset box shadow color
  rollover2-style2-insetboxshadow = rgba(128,255,255,0.6)
  # cat=bootstrap package: rollovercollection2-circle/style2/112; type=string; label=$rollover2-style2-insetboxshadow-hover: inset box shadow hover color
  rollover2-style2-insetboxshadow-hover = rgba(128,255,255,0.8)
  # cat=bootstrap package: rollovercollection2-circle/style2/113; type=string; label=$rollover2-style2-hoverbg: mask hover bg
  rollover2-style2-hoverbg = rgba(63,147,147, 0.8)
  # cat=bootstrap package: rollovercollection2-circle/style2/114; type=string; label=$rollover2-style2-titlecolor: title (heading) color
  rollover2-style2-titlecolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style2/115; type=string; label=$rollover2-style2-textcolor: text (paragraph) color
  rollover2-style2-textcolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style2/116; type=string; label=$rollover2-style2-hoverlinkcolor: hover link color
  rollover2-style2-hoverlinkcolor = yellow

  # cat=bootstrap package: rollovercollection2-circle/style3/117; type=string; label=$rollover2-style3-iconsize: circle width/height (140-280px)
  rollover2-style3-iconsize = 180px
  # cat=bootstrap package: rollovercollection2-circle/style3/118; type=options[none,block]; label=$rollover2-style3-showcaption: display or not the outside caption
  rollover2-style3-showcaption = block
  # cat=bootstrap package: rollovercollection2-circle/style3/119; type=string; label=$rollover2-style3-insetboxshadow: inset box shadow color
  rollover2-style3-insetboxshadow = rgba(128,255,255,0.6)
  # cat=bootstrap package: rollovercollection2-circle/style3/120; type=string; label=$rollover2-style3-bg: mask hover bg
