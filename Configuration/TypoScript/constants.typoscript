  rollover2-style5-textcolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style5/137; type=string; label=$rollover2-style5-hoverlinkcolor: hover link color
  rollover2-style5-hoverlinkcolor = yellow

  # cat=bootstrap package: rollovercollection2-circle/style6/138; type=string; label=$rollover2-style6-iconsize: circle width/height (140-280px)
  rollover2-style6-iconsize = 180px
  # cat=bootstrap package: rollovercollection2-circle/style6/139; type=options[none,block]; label=$rollover2-style6-showcaption: display or not the outside caption
  rollover2-style6-showcaption = none
  # cat=bootstrap package: rollovercollection2-circle/style6/140; type=string; label=$rollover2-style6-insetboxshadow: inset box shadow color
  rollover2-style6-insetboxshadow = rgba(23, 30, 115, 0.32)
  # cat=bootstrap package: rollovercollection2-circle/style6/141; type=string; label=$rollover2-style6-bg: mask hover bg
  rollover2-style6-bg = #f9f9f9
  # cat=bootstrap package: rollovercollection2-circle/style6/142; type=string; label=$rollover2-style6-titlecolor: title (heading) color
  rollover2-style6-titlecolor = #121212
  # cat=bootstrap package: rollovercollection2-circle/style6/143; type=string; label=$rollover2-style6-textcolor: text (paragraph) color
  rollover2-style6-textcolor = #121212
  # cat=bootstrap package: rollovercollection2-circle/style6/144; type=string; label=$rollover2-style6-hoverlinkcolor: hover link color
