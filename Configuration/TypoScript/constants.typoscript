  rollover2-style7-insetboxshadow = rgba(23, 30, 115, 0.32)
  # cat=bootstrap package: rollovercollection2-circle/style7/148; type=string; label=$rollover2-style7-bg: mask hover bg
  rollover2-style7-bg = rgba(130,0,0, 1)
  # cat=bootstrap package: rollovercollection2-circle/style7/149; type=string; label=$rollover2-style7-titlecolor: title (heading) color
  rollover2-style7-titlecolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style7/150; type=string; label=$rollover2-style7-textcolor: text (paragraph) color
  rollover2-style7-textcolor = #fff
  # cat=bootstrap package: rollovercollection2-circle/style7/151; type=string; label=$rollover2-style7-hoverlinkcolor: hover link color
  rollover2-style7-hoverlinkcolor = yellow
