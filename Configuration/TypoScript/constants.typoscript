  # cat=bootstrap package: rollovercollection2-circle/style7/145; type=string; label=$rollover2-style7-iconsize: circle width/height (140-280px)
  rollover2-style7-iconsize = 180px
  # cat=bootstrap package: rollovercollection2-circle/style7/146; type=options[none,block]; label=$rollover2-style7-showcaption: display or not the outside caption
